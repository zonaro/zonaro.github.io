{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Portfólio: Iniciar dashboard",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/portfolio-dashboard.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Portfólio: Atualizar site (publicar)",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/update-portfolio.sh",
        "--publish"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": false
      },
      "problemMatcher": []
    }
  ]
}
